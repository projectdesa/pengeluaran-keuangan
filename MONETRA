<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MONETRA – Smart Money Tracker</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f4f6f5;--card:#fff;--ink:#12302d;--mute:#6b7f7c;--line:#e1e8e6;--brand:#0f4c45;--brand2:#1f8a70;--out:#c4503a;--in:#1f8a70;--soft:#eaf2f0;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0c1917;--card:#132623;--ink:#e6f0ee;--mute:#8aa19d;--line:#244039;--brand:#2fb596;--brand2:#2fb596;--out:#ef7d66;--in:#4cc9a7;--soft:#1a312d}}
:root[data-theme="dark"]{--bg:#0c1917;--card:#132623;--ink:#e6f0ee;--mute:#8aa19d;--line:#244039;--brand:#2fb596;--brand2:#2fb596;--out:#ef7d66;--in:#4cc9a7;--soft:#1a312d}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Plus Jakarta Sans',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:15px;line-height:1.5}
.wrap{max-width:1000px;margin:0 auto;padding:20px 16px 48px}
header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px;flex-wrap:wrap}
.logo{display:flex;align-items:center;gap:12px}
.mark{width:42px;height:42px;border-radius:12px;background:var(--brand);display:grid;place-items:center;flex:none}
.logo h1{margin:0;font-size:22px;font-weight:800;letter-spacing:.06em;line-height:1.1}
.logo small{color:var(--mute);font-size:12px;font-weight:500}
input,select,button{font:inherit;color:inherit}
.month{display:flex;align-items:center;gap:4px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:4px}
.month button{border:0;background:none;width:34px;height:34px;border-radius:9px;cursor:pointer;font-size:18px}
.month button:hover{background:var(--soft)}
.month span{min-width:130px;text-align:center;font-weight:600}
.grid{display:grid;grid-template-columns:1fr 1.25fr;gap:16px;align-items:start}
@media(max-width:780px){.grid{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px}
.card h2{margin:0 0 14px;font-size:16px;font-weight:700}
.hero{background:var(--brand);color:#fff;border:0;padding:22px}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .hero{background:#17413a}}
:root[data-theme="dark"] .hero{background:#17413a}
.hero .lbl{opacity:.75;font-size:13px}
.hero .big{font-size:34px;font-weight:800;letter-spacing:-.02em;margin:2px 0 16px;word-break:break-word}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.stats div{background:rgba(255,255,255,.12);border-radius:12px;padding:10px 12px}
.stats b{display:block;font-size:15px}
.bud{margin-top:16px;font-size:13px}
.bar{height:8px;border-radius:99px;background:rgba(255,255,255,.2);overflow:hidden;margin:6px 0}
.bar i{display:block;height:100%;background:#fff;border-radius:99px;transition:width .4s}
.bar.warn i{background:#ffb4a2}
.link{background:none;border:0;color:inherit;text-decoration:underline;cursor:pointer;padding:0;font-size:13px;opacity:.9}
.seg{display:grid;grid-template-columns:1fr 1fr;background:var(--soft);border-radius:12px;padding:4px;margin-bottom:14px}
.seg button{border:0;background:none;padding:9px;border-radius:9px;font-weight:600;cursor:pointer;color:var(--mute)}
.seg button.on{background:var(--card);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.12)}
label{display:block;font-size:13px;font-weight:600;color:var(--mute);margin:12px 0 5px}
.f{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);outline:none}
.f:focus,button:focus-visible{outline:2px solid var(--brand2);outline-offset:1px}
.amt{display:flex;align-items:center;border:1px solid var(--line);border-radius:10px;background:var(--bg);padding-left:12px;font-weight:700}
.amt input{border:0;background:none;padding:12px;width:100%;outline:none;font-size:20px;font-weight:700}
.amt:focus-within{outline:2px solid var(--brand2)}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.save{width:100%;margin-top:18px;padding:13px;border:0;border-radius:12px;background:var(--brand);color:#fff;font-weight:700;cursor:pointer}
:root[data-theme="dark"] .save{color:#06201b}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .save{color:#06201b}}
.err{color:var(--out);font-size:13px;min-height:18px;margin-top:8px}
.cat{margin-bottom:12px}
.cat .t{display:flex;justify-content:space-between;font-size:14px;margin-bottom:4px}
.cat .t span:last-child{color:var(--mute)}
.cat .b{height:8px;background:var(--soft);border-radius:99px;overflow:hidden}
.cat .b i{display:block;height:100%;border-radius:99px;background:var(--brand2)}
.day{font-size:12px;font-weight:600;color:var(--mute);margin:16px 0 6px}
.tx{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--line)}
.tx:last-child{border-bottom:0}
.ic{width:38px;height:38px;border-radius:11px;background:var(--soft);display:grid;place-items:center;font-size:18px;flex:none}
.tx .m{flex:1;min-width:0}
.tx .m b{display:block;font-weight:600;font-size:14px}
.tx .m small{color:var(--mute);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block}
.tx .v{font-weight:700;font-size:14px;white-space:nowrap}
.tx .v.o{color:var(--out)}.tx .v.i{color:var(--in)}
.del{border:0;background:none;color:var(--mute);cursor:pointer;font-size:18px;width:30px;height:30px;border-radius:8px}
.del:hover{background:var(--soft);color:var(--out)}
.empty{text-align:center;color:var(--mute);padding:24px 8px}
.stack{display:grid;gap:16px}
.theme{border:1px solid var(--line);background:var(--card);border-radius:12px;width:42px;height:42px;cursor:pointer;font-size:17px}
.tools{display:flex;gap:8px;align-items:center}
.bform{display:flex;gap:6px;align-items:center}.bform span{font-weight:700}.bform input{flex:1;min-width:0;padding:8px 10px;border-radius:8px;border:0;background:#fff;color:#12302d;font-weight:600}.bform button{border:0;border-radius:8px;padding:8px 12px;font-weight:700;cursor:pointer;background:#fff;color:#0f4c45}.bform button.gh{background:rgba(255,255,255,.18);color:#fff}
.scan{border:1.5px dashed var(--brand2);border-radius:12px;padding:12px;display:flex;gap:12px;align-items:center;background:var(--soft)}.scan p{margin:0;font-size:13px;color:var(--mute)}.scan button{border:0;background:var(--brand);color:#fff;border-radius:10px;padding:10px 14px;font-weight:700;cursor:pointer;white-space:nowrap}.scan button:disabled{opacity:.6;cursor:wait}:root[data-theme="dark"] .scan button{color:#06201b}@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .scan button{color:#06201b}}.scanst{font-size:13px;margin:8px 0 14px;min-height:0}.scanst.e{color:var(--out)}.scanst button{margin-left:8px;border:0;background:none;color:var(--brand2);text-decoration:underline;cursor:pointer;font:inherit;padding:0}
.clock{margin:-8px 0 18px;color:var(--mute);font-size:13px;font-weight:600;font-variant-numeric:tabular-nums}
.cols{display:flex;gap:10px;align-items:flex-end}.col{flex:1;text-align:center;font-size:12px;min-width:0}.col small{display:block;color:var(--mute);font-size:11px}.bars{height:150px;display:flex;align-items:flex-end;justify-content:center;gap:4px;border-bottom:1px solid var(--line);margin-bottom:6px}.bw{flex:1;max-width:36px;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center}.bw em{font-style:normal;font-size:10px;color:var(--mute);white-space:nowrap}.bw i{display:block;width:100%;border-radius:5px 5px 0 0}.bo{background:var(--out)}.bi{background:var(--in)}.leg{display:flex;gap:16px;justify-content:center;margin-top:12px;font-size:12px;color:var(--mute)}.leg i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px}
</style>
</head>
<body>
<div class="wrap">
<header>
  <div class="logo">
    <div class="mark"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V6l8 9 8-9v13"/></svg></div>
    <div><h1>MONETRA</h1><small>Smart Money Tracker</small></div>
  </div>
  <div class="tools">
    <div class="month"><button id="prev" aria-label="Bulan sebelumnya">‹</button><span id="mlabel"></span><button id="next" aria-label="Bulan berikutnya">›</button></div>
    <button class="theme" id="theme" aria-label="Ganti tema">◐</button>
  </div>
</header>
<div class="clock" id="clock"></div>

<div class="grid">
  <div class="stack">
    <div class="card hero">
      <div class="lbl">Total pengeluaran bulan ini</div>
      <div class="big" id="out">Rp0</div>
      <div class="stats">
        <div><span class="lbl">Rata-rata per hari</span><b id="avg">Rp0</b></div>
        <div><span class="lbl">Jumlah transaksi</span><b id="cnt">0</b></div>
      </div>
      <div class="bud" id="bud"></div>
    </div>
    <div class="card">
      <h2>Catat pengeluaran</h2>
      <div id="scanbox" hidden><div class="scan"><button id="scanbtn" type="button">📷 Pindai struk</button><p>Foto struk belanja, isinya dibaca dan disimpan otomatis.</p></div><div class="scanst" id="scanst" role="status"></div><input id="scanfile" type="file" accept="image/*" capture="environment" hidden></div>
      
      <label for="amount">Nominal</label>
      <div class="amt">Rp<input id="amount" inputmode="numeric" placeholder="0" autocomplete="off"></div>
      <label for="cat">Kategori</label>
      <select id="cat" class="f"></select>
      <div class="row2">
        <div><label for="date">Tanggal</label><input id="date" type="date" class="f"></div>
        <div><label for="note">Catatan</label><input id="note" class="f" placeholder="Opsional" maxlength="60"></div>
      </div>
      <div class="err" id="err" role="alert"></div>
      <button class="save" id="save" type="button">Simpan pengeluaran</button>
    </div>
  </div>

  <div class="stack">
    <div class="card"><h2>Grafik pengeluaran</h2><div class="seg" id="ctabs"><button class="on" data-c="w" type="button">Mingguan</button><button data-c="m" type="button">Bulanan</button></div><div id="chart"></div></div>
    <div class="card"><h2>Pengeluaran per kategori</h2><div id="cats"></div></div>
    <div class="card"><h2>Riwayat transaksi</h2><div id="list"></div></div>
  </div>
</div>
</div>

<script>
const OUT=[["Makan & Minum","🍜"],["Transportasi","🚌"],["Belanja","🛍️"],["Tagihan","💡"],["Kesehatan","💊"],["Hiburan","🎬"],["Pendidikan","📚"],["Lainnya","📦"]];

const KEY="monetra:v1";
let S={tx:[],budget:0},type="out",cur=new Date();cur.setDate(1);
try{const r=localStorage.getItem(KEY);if(r){const p=JSON.parse(r);if(p&&Array.isArray(p.tx)){S=p;S.tx=S.tx.filter(t=>t.type!=="in")}}}catch(e){}
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}};
const $=id=>document.getElementById(id);
const rp=n=>"Rp"+Math.round(n).toLocaleString("id-ID");
const iso=d=>d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
const icon=(t,c)=>(OUT.find(x=>x[0]===c)||["","📦"])[1];
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

function fillCats(){$("cat").innerHTML=OUT.map(c=>`<option>${c[0]}</option>`).join("")}

$("amount").oninput=e=>{const d=e.target.value.replace(/\D/g,"");e.target.value=d?Number(d).toLocaleString("id-ID"):""};
$("date").value=iso(new Date());
let dateTouched=false,lastDay=iso(new Date());
$("date").oninput=()=>{dateTouched=true};
function tick(){
  const n=new Date(),d=iso(n);
  $("clock").textContent=n.toLocaleDateString("id-ID",{weekday:"long",day:"numeric",month:"long",year:"numeric"})+" · "+n.toLocaleTimeString("id-ID",{hour:"2-digit",minute:"2-digit",second:"2-digit",hour12:false,timeZoneName:"short"}).replace(/\./g,":");
  $("date").max=d;
  if(d!==lastDay){
    const pm=lastDay.slice(0,7),cm=cur.getFullYear()+"-"+String(cur.getMonth()+1).padStart(2,"0");
    if(d.slice(0,7)!==pm&&cm===pm)cur=new Date(n.getFullYear(),n.getMonth(),1);
    lastDay=d;if(!dateTouched)$("date").value=d;render();
  }
}
setInterval(tick,1000);tick();

$("save").onclick=()=>{
  const amount=Number($("amount").value.replace(/\D/g,""));
  if(!amount){$("err").textContent="Masukkan nominal lebih dari 0.";return}
  if(!$("date").value){$("err").textContent="Pilih tanggal transaksi.";return}
  $("err").textContent="";
  S.tx.push({id:Date.now()+Math.random(),type,amount,cat:$("cat").value,date:$("date").value,note:$("note").value.trim()});
  save();$("amount").value="";$("note").value="";
  const d=new Date($("date").value+"T00:00:00");cur=new Date(d.getFullYear(),d.getMonth(),1);
  render();
};
$("prev").onclick=()=>{cur=new Date(cur.getFullYear(),cur.getMonth()-1,1);render()};
$("next").onclick=()=>{cur=new Date(cur.getFullYear(),cur.getMonth()+1,1);render()};
$("theme").onclick=()=>{const r=document.documentElement;const dark=r.dataset.theme?r.dataset.theme==="dark":matchMedia("(prefers-color-scheme:dark)").matches;r.dataset.theme=dark?"light":"dark"};
$("list").onclick=e=>{const b=e.target.closest("[data-del]");if(!b)return;S.tx=S.tx.filter(t=>String(t.id)!==b.dataset.del);save();render()};
let editBud=false;
$("bud").onclick=e=>{const b=e.target.closest("button");if(!b)return;const a=b.dataset.a;
  if(a==="edit"){editBud=true;render();const i=$("budin");if(i)i.focus()}
  else if(a==="cancel"){editBud=false;render()}
  else if(a==="save"){S.budget=Number($("budin").value.replace(/\D/g,""))||0;save();editBud=false;render()}};
$("bud").oninput=e=>{if(e.target.id==="budin"){const d=e.target.value.replace(/\D/g,"");e.target.value=d?Number(d).toLocaleString("id-ID"):""}};
$("bud").onkeydown=e=>{if(e.key==="Enter"&&e.target.id==="budin")$("bud").querySelector('[data-a="save"]').click()};

function render(){
  const ym=cur.getFullYear()+"-"+String(cur.getMonth()+1).padStart(2,"0");
  $("mlabel").textContent=cur.toLocaleDateString("id-ID",{month:"long",year:"numeric"});
  const tx=S.tx.filter(t=>t.date.startsWith(ym)).sort((a,b)=>b.date.localeCompare(a.date)||b.id-a.id);
  const out=tx.filter(t=>t.type==="out").reduce((s,t)=>s+t.amount,0);
  const now=new Date(),dim=new Date(cur.getFullYear(),cur.getMonth()+1,0).getDate(),dd=(now.getFullYear()===cur.getFullYear()&&now.getMonth()===cur.getMonth())?now.getDate():dim;
  $("out").textContent=rp(out);$("avg").textContent=rp(out/dd);$("cnt").textContent=tx.length;
  if(editBud){$("bud").innerHTML=`<div class="bform"><span>Rp</span><input id="budin" inputmode="numeric" placeholder="Contoh: 3.000.000" aria-label="Anggaran bulanan" value="${S.budget?S.budget.toLocaleString("id-ID"):""}"><button type="button" data-a="save">Simpan</button><button type="button" data-a="cancel" class="gh">Batal</button></div>`}
  else if(S.budget){const p=Math.min(100,out/S.budget*100),left=S.budget-out;
    $("bud").innerHTML=`<div>Anggaran ${rp(S.budget)} · ${left>=0?"sisa "+rp(left):"melebihi "+rp(-left)}</div><div class="bar ${out>S.budget*.9?"warn":""}"><i style="width:${p}%"></i></div><button class="link" type="button" data-a="edit">Ubah anggaran</button>`}
  else $("bud").innerHTML=`<button class="link" type="button" data-a="edit">+ Atur anggaran bulanan</button>`;
  chart();
  const by={};tx.filter(t=>t.type==="out").forEach(t=>by[t.cat]=(by[t.cat]||0)+t.amount);
  const rows=Object.entries(by).sort((a,b)=>b[1]-a[1]);
  $("cats").innerHTML=rows.length?rows.map(([c,v])=>`<div class="cat"><div class="t"><span>${icon("out",c)} ${esc(c)}</span><span>${rp(v)} · ${Math.round(v/out*100)}%</span></div><div class="b"><i style="width:${v/out*100}%"></i></div></div>`).join(""):`<div class="empty">Belum ada pengeluaran di bulan ini.</div>`;
  let h="",last="";
  tx.forEach(t=>{
    if(t.date!==last){last=t.date;h+=`<div class="day">${new Date(t.date+"T00:00:00").toLocaleDateString("id-ID",{weekday:"long",day:"numeric",month:"long"})}</div>`}
    h+=`<div class="tx"><div class="ic">${icon(t.type,t.cat)}</div><div class="m"><b>${esc(t.cat)}</b><small>${t.scan?"📷 ":""}${esc(t.note||"Tanpa catatan")}</small></div><div class="v o">−${rp(t.amount)}</div><button class="del" data-del="${t.id}" aria-label="Hapus transaksi">×</button></div>`;
  });
  $("list").innerHTML=h||`<div class="empty">Belum ada transaksi. Catat yang pertama di formulir.</div>`;
}
let SM=null;
(async()=>{try{if(!window.claude)return;const s=await claude.use("sample");if(!s)return;const l=await s.limits();if(l&&l.images){SM=s;$("scanbox").hidden=false}}catch(e){}})();
function shrink(file){return new Promise((res,rej)=>{const img=new Image(),u=URL.createObjectURL(file);img.onload=()=>{const k=Math.min(1,1400/Math.max(img.width,img.height)),c=document.createElement("canvas");c.width=Math.round(img.width*k);c.height=Math.round(img.height*k);c.getContext("2d").drawImage(img,0,0,c.width,c.height);URL.revokeObjectURL(u);c.toBlob(b=>b?res(b):rej(new Error("x")),"image/jpeg",.85)};img.onerror=()=>rej(new Error("x"));img.src=u})}
$("scanbtn").onclick=()=>$("scanfile").click();
$("scanst").onclick=e=>{const b=e.target.closest("button");if(!b)return;S.tx=S.tx.filter(t=>String(t.id)!==b.dataset.undo);save();$("scanst").textContent="Transaksi struk dibatalkan.";render()};
$("scanfile").onchange=async e=>{
  const f=e.target.files[0];e.target.value="";if(!f||!SM)return;
  const st=$("scanst"),btn=$("scanbtn");st.className="scanst";st.textContent="Membaca struk… ini bisa memakan waktu beberapa detik.";btn.disabled=true;
  try{
    const blob=await shrink(f);
    const cats=OUT.map(c=>c[0]);
    const p=`Kamu membaca foto struk belanja di Indonesia. Balas HANYA dengan JSON, tanpa teks lain: {"valid":true/false,"merchant":"nama toko","date":"YYYY-MM-DD" atau null,"total":bilangan bulat Rupiah dari total akhir yang dibayar tanpa titik atau koma,"category":salah satu dari ${JSON.stringify(cats)},"items":"ringkasan maksimal 5 item utama, dipisah koma"}. Jika gambar bukan struk atau total tidak terbaca, isi valid=false. Hari ini ${iso(new Date())}.`;
    const r=await SM.json(p,{images:[blob],cache:false});
    const amount=Math.round(Number(r&&r.total));
    if(!r||!r.valid||!(amount>0))throw {code:"unread"};
    const today=iso(new Date());
    const date=/^\d{4}-\d{2}-\d{2}$/.test(r.date||"")&&r.date<=today?r.date:today;
    const cat=cats.includes(r.category)?r.category:"Lainnya";
    const note=[String(r.merchant||"").trim(),String(r.items||"").trim()].filter(Boolean).join(" – ").slice(0,90);
    const id=Date.now()+Math.random();
    S.tx.push({id,type:"out",amount,cat,date,note,scan:1});save();
    const d=new Date(date+"T00:00:00");cur=new Date(d.getFullYear(),d.getMonth(),1);render();
    st.textContent="✓ Tersimpan: "+(r.merchant||"Struk")+" · "+rp(amount)+" · "+cat;
    const u=document.createElement("button");u.type="button";u.dataset.undo=id;u.textContent="Batalkan";st.appendChild(u);
  }catch(err){
    st.className="scanst e";
    st.textContent=err&&err.code==="not_granted"?"Izin membaca struk ditolak. Izinkan lalu coba lagi.":err&&err.code==="rate_limited"?"Terlalu banyak permintaan. Tunggu sebentar lalu coba lagi.":"Struk tidak terbaca jelas. Foto ulang dengan pencahayaan cukup, atau isi manual di bawah.";
  }finally{btn.disabled=false}
};
let ctab="w";
const mk=(y,m)=>y+"-"+String(m+1).padStart(2,"0");
const cp=n=>n>=1e6?(n/1e6).toFixed(1).replace(".0","")+"jt":n>=1e3?Math.round(n/1e3)+"rb":String(n);
$("ctabs").onclick=e=>{const b=e.target.closest("button");if(!b)return;ctab=b.dataset.c;[...$("ctabs").children].forEach(x=>x.classList.toggle("on",x===b));chart()};
function chart(){
  const y=cur.getFullYear(),m=cur.getMonth();let items=[];
  if(ctab==="w"){
    const n=new Date(y,m+1,0).getDate(),k=Math.ceil(n/7);
    items=Array.from({length:k},(_,i)=>({l:"Mgg "+(i+1),o:0,i:0,s:i*7+1,e:Math.min(n,i*7+7)}));
    S.tx.forEach(t=>{if(!t.date.startsWith(mk(y,m)))return;const d=+t.date.slice(8,10),w=items[Math.min(k-1,Math.floor((d-1)/7))];if(t.type==="out")w.o+=t.amount});
  }else{
    for(let j=5;j>=0;j--){const d=new Date(y,m-j,1);items.push({l:d.toLocaleDateString("id-ID",{month:"short"}),o:0,i:0,key:mk(d.getFullYear(),d.getMonth())})}
    S.tx.forEach(t=>{const it=items.find(x=>t.date.startsWith(x.key));if(it&&t.type==="out")it.o+=t.amount});
  }
  const mx=Math.max(1,...items.map(x=>x.o));
  $("chart").innerHTML=`<div class="cols">${items.map(x=>`<div class="col"><div class="bars"><div class="bw"><em>${x.o?cp(x.o):""}</em><i class="bo" style="height:${x.o/mx*88}%"></i></div></div><span>${x.l}</span>${x.s?`<small>${x.s}–${x.e}</small>`:""}</div>`).join("")}</div>`;
}
fillCats();render();
</script>
</body>
</html>
